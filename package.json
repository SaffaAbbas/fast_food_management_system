    "test:pos": "electron test/pos_tables_test.js",
    "test:kitchen": "electron test/kitchen_test.js",
    "test:inventory": "electron test/inventory_recipes_test.js",
    "test:staff": "electron test/shifts_staff_test.js",
    "test:crm": "electron test/crm_reservations_test.js",
    "test:delivery": "electron test/delivery_dispatch_test.js",
    "test:reports": "electron test/reports_settings_test.js",
    "test:all": "npm run test:db && npm run test:auth && npm run test:catalog && npm run test:pos && npm run test:kitchen && npm run test:inventory && npm run test:staff && npm run test:crm && npm run test:delivery && npm run test:reports",
    "seed:dummy": "electron electron/db/populate_all_dummy_data.js",
