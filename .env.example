# Local desktop only. Never commit real keys.
# Copy to .env (developer PC) or paste the same values in Settings → Cloud sync.
# GitHub = app source code. Supabase = live restaurant data backup.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=

# Outgoing mail for signup verification codes.
# Gmail example: smtp.gmail.com, port 587, and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
